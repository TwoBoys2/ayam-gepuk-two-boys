
<!DOCTYPE html>
<html lang="ms">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#f8f0df">
<meta name="description" content="Ayam Gepuk Two Boys - Pedas padu, puas makan!">
<title>Ayam Gepuk Two Boys</title>

<style>
:root {
  --cream: #f8f0df;
  --orange: #ef7627;
  --dark: #173d2b;
  --green: #326345;
  --white: #fffdf7;
  --text: #263329;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  background: var(--cream);
  color: var(--text);
  line-height: 1.6;
}

a {
  text-decoration: none;
  color: inherit;
}

.container {
  width: min(1120px, 90%);
  margin: auto;
}

header {
  background: var(--cream);
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1px solid #e8dcc5;
}

.navbar {
  min-height: 76px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
}

.logo {
  color: var(--dark);
  font-size: 19px;
  font-weight: 900;
  line-height: 1.15;
}

.logo span {
  display: block;
  color: var(--orange);
  font-size: 12px;
  letter-spacing: 3px;
  margin-top: 5px;
}

.nav-links {
  display: flex;
  gap: 25px;
  align-items: center;
  font-size: 14px;
  font-weight: bold;
}

.nav-links a:hover {
  color: var(--orange);
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  background: var(--orange);
  color: white;
  padding: 13px 21px;
  border-radius: 50px;
  font-weight: bold;
  border: 2px solid var(--orange);
  transition: .2s;
  cursor: pointer;
}

.btn:hover {
  transform: translateY(-2px);
  filter: brightness(.96);
}

.btn-outline {
  background: transparent;
  color: var(--dark);
  border-color: var(--dark);
}

.hero {
  padding: 75px 0 65px;
  overflow: hidden;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.1fr .9fr;
  align-items: center;
  gap: 45px;
}

.eyebrow {
  display: inline-block;
  color: var(--green);
  font-size: 12px;
  font-weight: 900;
  letter-spacing: 2px;
  text-transform: uppercase;
  margin-bottom: 18px;
}

h1 {
  color: var(--dark);
  font-size: clamp(42px, 6vw, 72px);
  line-height: 1.04;
  letter-spacing: -2px;
  margin-bottom: 22px;
}

h1 span {
  color: var(--orange);
}

.hero p {
  font-size: 17px;
  max-width: 480px;
  margin-bottom: 27px;
}

.hero-buttons {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.hero-image {
  min-height: 380px;
  border-radius: 48% 48% 25px 25px;
  background: var(--dark);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  padding: 25px;
}

.hero-image img {
  width: 100%;
  height: 370px;
  object-fit: cover;
  border-radius: 46% 46% 20px 20px;
}

.hero-sticker {
  position: absolute;
  bottom: 22px;
  left: 18px;
  background: var(--orange);
  color: white;
  padding: 13px 18px;
  border-radius: 15px;
  font-weight: 900;
  transform: rotate(-4deg);
}

.trust {
  background: var(--dark);
  color: white;
  padding: 19px 0;
}

.trust-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  text-align: center;
  font-weight: bold;
  font-size: 14px;
}

.trust-grid span {
  color: #ffc36b;
  margin-right: 5px;
}

section {
  padding: 78px 0;
}

.section-heading {
  text-align: center;
  max-width: 650px;
  margin: 0 auto 38px;
}

.section-heading .eyebrow {
  margin-bottom: 8px;
}

h2 {
  font-size: clamp(30px, 4vw, 43px);
  color: var(--dark);
  line-height: 1.15;
  margin-bottom: 12px;
}

.section-heading p {
  color: #657064;
}

.menu-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22px;
}

.menu-card {
  background: var(--white);
  border: 1px solid #eadfcd;
  border-radius: 22px;
  overflow: hidden;
  transition: transform .2s, box-shadow .2s;
}

.menu-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 12px 28px #173d2b12;
}

.menu-photo {
  height: 200px;
  background: #e9dfc9;
  overflow: hidden;
}

.menu-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.menu-content {
  padding: 22px;
}

.menu-content h3 {
  color: var(--dark);
  font-size: 20px;
  margin-bottom: 7px;
}

.menu-content p {
  color: #6d7469;
  font-size: 14px;
  min-height: 45px;
}

.menu-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-top: 17px;
}

.price {
  color: var(--orange);
  font-size: 23px;
  font-weight: 900;
}

.order-small {
  background: var(--dark);
  color: white;
  padding: 9px 14px;
  border-radius: 30px;
  font-size: 13px;
  font-weight: bold;
}

.story {
  background: #eee3cd;
}

.story-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 55px;
}

.story-art {
  background: var(--dark);
  color: white;
  border-radius: 25px;
  padding: 45px 28px;
  text-align: center;
}

.story-art .big {
  font-size: 75px;
  line-height: 1.3;
}

.story-art h3 {
  font-size: 28px;
  color: #ffc36b;
}

.story-text p {
  margin: 16px 0 23px;
}

.story-points {
  display: grid;
  gap: 12px;
  margin-bottom: 25px;
}

.story-points div {
  font-weight: bold;
}

.story-points span {
  color: var(--orange);
  margin-right: 8px;
}

.order-section {
  background: var(--dark);
  color: white;
  text-align: center;
}

.order-section h2 {
  color: white;
}

.order-section p {
  max-width: 560px;
  margin: 0 auto 25px;
  color: #e2e8df;
}

.order-section .eyebrow {
  color: #ffc36b;
}

.order-section .btn-outline {
  color: white;
  border-color: white;
}

.order-buttons {
  display: flex;
  justify-content: center;
  gap: 12px;
  flex-wrap: wrap;
}

footer {
  padding: 28px 0;
  background: #102d1f;
  color: #e4eadf;
  font-size: 13px;
}

.footer-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  flex-wrap: wrap;
}

.footer-name {
  font-size: 17px;
  font-weight: 900;
  color: white;
}

.footer-name span {
  color: #ff9b4c;
}

.whatsapp-float {
  position: fixed;
  right: 18px;
  bottom: 20px;
  z-index: 200;
  background: #20b968;
  color: white;
  padding: 13px 17px;
  border-radius: 40px;
  font-weight: bold;
  box-shadow: 0 5px 20px #0002;
}

@media (max-width: 800px) {
  .hero-grid,
  .story-grid {
    grid-template-columns: 1fr;
  }

  .hero {
    padding-top: 45px;
  }

  .hero-image {
    min-height: 300px;
    max-width: 550px;
    width: 100%;
    margin: auto;
  }

  .hero-image img {
    height: 300px;
  }

  .menu-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .story-grid {
    gap: 30px;
  }

  .nav-links {
    gap: 12px;
  }
}

@media (max-width: 520px) {
  .container {
    width: 91%;
  }

  .navbar {
    min-height: 68px;
  }

  .logo {
    font-size: 16px;
  }

  .nav-links {
    display: none;
  }

  .navbar > .btn {
    padding: 10px 14px;
    font-size: 12px;
  }

  h1 {
    font-size: 44px;
  }

  .hero p {
    font-size: 15px;
  }

  .hero-buttons {
    flex-direction: column;
  }

  .hero-buttons .btn {
    width: 100%;
  }

  section {
    padding: 55px 0;
  }

  .trust-grid {
    font-size: 11px;
  }

  .menu-grid {
    grid-template-columns: 1fr;
  }

  .menu-photo {
    height: 220px;
  }

  .menu-content p {
    min-height: 0;
  }

  .story-art .big {
    font-size: 60px;
  }

  .whatsapp-float {
    right: 12px;
    bottom: 12px;
    padding: 11px 14px;
    font-size: 13px;
  }

  .footer-inner {
    flex-direction: column;
    text-align: center;
  }
}
</style>
</head>

<body>

<header>
  <div class="container navbar">
    <a href="#home" class="logo">
      AYAM GEPUK
      <span>TWO BOYS</span>
    </a>

    <nav class="nav-links">
      <a href="#home">Utama</a>
      <a href="#menu">Menu</a>
      <a href="#cerita">Tentang Kami</a>
    </nav>

    <a href="#pesan" class="btn">Pesan Sekarang</a>
  </div>
</header>

<main>
<section class="hero" id="home">
  <div class="container hero-grid">
    <div>
      <span class="eyebrow">Pedas padu, puas makan!</span>

      <h1>SEKALI CUBA,<br><span>NAK LAGI!</span></h1>

      <p>
        Nikmati ayam gepuk yang rangup, sambal yang menyengat
        dan hidangan yang mengenyangkan. Kepuasan setiap suapan
        bersama Ayam Gepuk Two Boys!
      </p>

      <div class="hero-buttons">
        <a href="#menu" class="btn">Lihat Menu ↗</a>
        <a href="#cerita" class="btn btn-outline">Kenali Kami</a>
      </div>
    </div>

    <div class="hero-image">
      <img
        src="https://images.unsplash.com/photo-1626082927389-6cd097cdc6ec?auto=format&fit=crop&w=900&q=85"
        alt="Hidangan ayam goreng rangup"
      >
      <div class="hero-sticker">🔥 SAMBAL PADU!</div>
    </div>
  </div>
</section>

<div class="trust">
  <div class="container trust-grid">
    <div><span>✦</span> Ayam Rangup</div>
    <div><span>🌶</span> Sambal Menyengat</div>
    <div><span>♥</span> Puas Hati</div>
  </div>
</div>

<section id="menu">
  <div class="container">
    <div class="section-heading">
      <span class="eyebrow">Pilihan kegemaran</span>
      <h2>MENU PILIHAN KAMI</h2>
      <p>
        Pilih hidangan kegemaran anda dan nikmati rasa
        yang pasti membuka selera.
      </p>
    </div>

    <div class="menu-grid">

      <article class="menu-card">
        <div class="menu-photo">
          <img
            src="https://images.unsplash.com/photo-1626082927389-6cd097cdc6ec?auto=format&fit=crop&w=700&q=80"
            alt="Ayam goreng"
            loading="lazy"
          >
        </div>
        <div class="menu-content">
          <h3>Set Ayam Gepuk</h3>
          <p>Ayam goreng rangup bersama nasi dan sambal pilihan.</p>
          <div class="menu-bottom">
            <span class="price">RM12.00</span>
            <a class="order-small" href="#pesan"
               onclick="pilihMenu('Set Ayam Gepuk')">Pesan</a>
          </div>
        </div>
      </article>

      <article class="menu-card">
        <div class="menu-photo">
          <img
            src="https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?auto=format&fit=crop&w=700&q=80"
            alt="Hidangan istimewa"
            loading="lazy"
          >
        </div>
        <div class="menu-content">
          <h3>Set Special Two Boys</h3>
          <p>Hidangan istimewa untuk anda yang datang dengan selera besar.</p>
          <div class="menu-bottom">
            <span class="price">RM15.00</span>
            <a class="order-small" href="#pesan"
               onclick="pilihMenu('Set Special Two Boys')">Pesan</a>
          </div>
        </div>
      </article>

      <article class="menu-card">
        <div class="menu-photo">
          <img
            src="https://images.unsplash.com/photo-1512621776951-a57141f2eefd?auto=format&fit=crop&w=700&q=80"
            alt="Sayur segar"
            loading="lazy"
          >
        </div>
        <div class="menu-content">
          <h3>Set Ayam Gepuk Sayur</h3>
          <p>Gabungan ayam, nasi dan sayur untuk hidangan lebih lengkap.</p>
          <div class="menu-bottom">
            <span class="price">RM13.00</span>
            <a class="order-small" href="#pesan"
               onclick="pilihMenu('Set Ayam Gepuk Sayur')">Pesan</a>
          </div>
        </div>
      </article>

      <article class="menu-card">
        <div class="menu-photo">
          <img
            src="https://images.unsplash.com/photo-1562967914-608f82629710?auto=format&fit=crop&w=700&q=80"
            alt="Ayam goreng rangup"
            loading="lazy"
          >
        </div>
        <div class="menu-content">
          <h3>Ayam Gepuk Extra</h3>
          <p>Tambahan ayam untuk penggemar ayam goreng rangup.</p>
          <div class="menu-bottom">
            <span class="price">RM8.00</span>
            <a class="order-small" href="#pesan"
               onclick="pilihMenu('Ayam Gepuk Extra')">Pesan</a>
          </div>
        </div>
      </article>

      <article class="menu-card">
        <div class="menu-photo">
          <img
            src="https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=700&q=80"
            alt="Sambal dan hidangan"
            loading="lazy"
          >
        </div>
        <div class="menu-content">
          <h3>Sambal Extra</h3>
          <p>Untuk peminat pedas yang mahukan sambal tambahan.</p>
          <div class="menu-bottom">
            <span class="price">RM2.00</span>
            <a class="order-small" href="#pesan"
               onclick="pilihMenu('Sambal Extra')">Pesan</a>
          </div>
        </div>
      </article>

      <article class="menu-card">
        <div class="menu-photo">
          <img
            src="https://images.unsplash.com/photo-1513558161293-cdaf765edfd4?auto=format&fit=crop&w=700&q=80"
            alt="Minuman sejuk"
            loading="lazy"
          >
        </div>
        <div class="menu-content">
          <h3>Minuman Sejuk</h3>
          <p>Lengkapkan hidangan anda dengan minuman yang menyegarkan.</p>
          <div class="menu-bottom">
            <span class="price">RM3.00</span>
            <a class="order-small" href="#pesan"
               onclick="pilihMenu('Minuman Sejuk')">Pesan</a>
          </div>
        </div>
      </article>

    </div>

    <p style="text-align:center;font-size:12px;color:#777;margin-top:22px">
      Nota: Harga dan menu di atas ialah contoh. Sila sesuaikan
      dengan menu serta harga sebenar perniagaan.
    </p>
  </div>
</section>

<section class="story" id="cerita">
  <div class="container story-grid">

    <div class="story-art">
      <div class="big">🌶️ 🍗</div>
      <h3>TWO BOYS</h3>
      <p>Pedasnya terasa, nikmatnya bersama.</p>
    </div>

    <div class="story-text">
      <span class="eyebrow">Cerita kami</span>
      <h2>BUKAN SEKADAR AYAM GEPUK</h2>
      <p>
        Ayam Gepuk Two Boys membawa semangat untuk menyajikan
        hidangan yang menyelerakan, sambal yang membangkitkan
        selera dan pengalaman makan yang menyeronokkan.
      </p>
      <p>
        Sama ada makan bersama keluarga, kawan atau menikmati
        hidangan sendiri, kami mahu setiap kunjungan menjadi
        pengalaman yang anda ingat.
      </p>

      <div class="story-points">
        <div><span>✓</span> Hidangan yang menyelerakan</div>
        <div><span>✓</span> Pilihan sambal mengikut selera</div>
        <div><span>✓</span> Sesuai dinikmati bersama</div>
      </div>

      <a href="#pesan" class="btn">Jom Buat Pesanan</a>
    </div>

  </div>
</section>

<section class="order-section" id="pesan">
  <div class="container">
    <span class="eyebrow">Perut dah lapar?</span>
    <h2>JOM MAKAN GEPUK!</h2>
    <p>
      Dah jumpa menu kegemaran? Hubungi kami melalui WhatsApp
      untuk bertanya tentang menu, harga dan cara membuat pesanan.
    </p>

    <div class="order-buttons">
      <a id="whatsapp-main" href="#" class="btn"
         onclick="return bukaWhatsApp('Hai Ayam Gepuk Two Boys! Saya nak bertanya tentang menu dan pesanan.')">
        WhatsApp Kami ↗
      </a>
      <a href="#menu" class="btn btn-outline">Lihat Menu</a>
    </div>
  </div>
</section>
</main>

<footer>
  <div class="container footer-inner">
    <div>
      <div class="footer-name">AYAM GEPUK <span>TWO BOYS</span></div>
      <div>Pedas padu, puas makan!</div>
    </div>
    <div>© <span id="year"></span> Ayam Gepuk Two Boys.</div>
  </div>
</footer>

<a href="#" class="whatsapp-float"
   onclick="return bukaWhatsApp('Hai Ayam Gepuk Two Boys! Saya nak bertanya tentang pesanan.')">
  WhatsApp ↗
</a>

<script>
/*
  PENTING:
  Gantikan nombor di bawah dengan nombor WhatsApp
  perniagaan. Gunakan kod negara 60 tanpa tanda +.
  Contoh format: 60123456789
*/
const NOMBOR_WHATSAPP = "60123456789";

document.getElementById("year").textContent =
  new Date().getFullYear();

function bukaWhatsApp(mesej) {
  if (
    !NOMBOR_WHATSAPP ||
    NOMBOR_WHATSAPP === "60123456789"
  ) {
    alert(
      "Sila tetapkan nombor WhatsApp perniagaan dalam kod website dahulu."
    );
    return false;
  }

  const url =
    "https://wa.me/" +
    NOMBOR_WHATSAPP +
    "?text=" +
    encodeURIComponent(mesej);

  window.open(url, "_blank");
  return false;
}

function pilihMenu(namaMenu) {
  const mesej =
    "Hai Ayam Gepuk Two Boys! Saya berminat untuk memesan: " +
    namaMenu +
    ". Boleh berikan maklumat lanjut?";

  bukaWhatsApp(mesej);
}
</script>

</body>
</html>
